<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yanika Snack</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        
        :root {
            --cream: #FFF7EA;
            --orange: #F99D23;
            --orange-light: #FFE9CC;
            --text-dark: #5C3A1E;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--cream);
            color: var(--text-dark);
        }
        
        .btn-orange {
            background-color: var(--orange);
            transition: all 0.2s ease;
        }
        .btn-orange:hover {
            background-color: #E88E15;
        }
        .btn-orange-light {
            background-color: var(--orange-light);
            color: var(--text-dark);
            transition: all 0.2s ease;
        }
        .btn-orange-light:hover {
            background-color: #FFDFB3;
        }
        .card {
            background: #FFFFFF;
            border-radius: 20px;
            overflow: hidden;
            transition: transform 0.2s ease;
        }
        .card:hover {
            transform: translateY(-3px);
        }
        .tag-category {
            background-color: var(--orange-light);
            color: var(--text-dark);
            font-size: 12px;
            padding: 3px 10px;
            border-radius: 20px;
            display: inline-block;
        }
        .promo-badge {
            background: linear-gradient(135deg, #FF5722, #FF9800);
            color: white;
            font-size: 12px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 20px;
            position: absolute;
            top: 10px;
            right: 10px;
        }
        .bestseller-badge {
            background: linear-gradient(135deg, #E53935, #FF5722);
            color: white;
            font-size: 11px;
            font-weight: 600;
            padding: 3px 8px;
            border-radius: 20px;
            position: absolute;
            top: 10px;
            left: 10px;
        }
    </style>
</head>
<body class="min-h-screen">

<!-- Header -->
<header class="bg-white/80 backdrop-blur-sm sticky top-0 z-50 px-4 py-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-orange-500 flex items-center justify-center">
                <i class="fa fa-tree text-white text-xl"></i>
            </div>
            <h1 class="text-xl font-bold" style="color: var(--orange)">Yanika Snack</h1>
        </div>
        <button class="btn-orange text-white px-5 py-2.5 rounded-full flex items-center gap-2 shadow-sm">
            <i class="fa fa-shopping-cart"></i>
            <span>Keranjang</span>
            <span id="cart-count" class="bg-white text-orange-500 rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold">0</span>
        </button>
    </div>
</header>

<!-- Produk Unggulan / Atas -->
<section class="max-w-7xl mx-auto px-4 pt-4 pb-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4" id="top-products">
        <!-- Produk atas dimuat di sini -->
    </div>
</section>

<!-- Search & Filter -->
<section class="max-w-7xl mx-auto px-4 pb-4">
    <div class="bg-white rounded-2xl p-4 shadow-sm mb-4">
        <div class="relative mb-4">
            <i class="fa fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
            <input type="text" id="search" placeholder="Cari nama produk..." 
                class="w-full pl-10 pr-4 py-3 rounded-xl bg-gray-50 border-0 focus:outline-none">
        </div>
        <div class="relative">
            <select id="category" class="w-full px-4 py-2.5 rounded-xl bg-gray-50 border-0 appearance-none focus:outline-none">
                <option value="all">Semua Kategori</option>
                <option value="jelly">Jelly</option>
                <option value="keripik">Keripik</option>
                <option value="kacang">Kacang</option>
                <option value="kue-kering">Kue Kering</option>
                <option value="permen">Permen</option>
            </select>
            <i class="fa fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
        </div>
    </div>
</section>

<!-- Semua Produk -->
<section class="max-w-7xl mx-auto px-4 pb-24">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" id="products">
        <!-- Semua produk dimuat di sini -->
    </div>
</section>

<!-- Tombol WhatsApp Tetap di Bawah Kanan -->
<a href="https://wa.me/6285721349673?text=Halo%20Yanika%20Snack%2C%20saya%20mau%20pesan" 
    target="_blank" 
    class="fixed bottom-6 right-6 bg-green-500 text-white w-14 h-14 rounded-full flex items-center justify-center shadow-lg z-50 hover:bg-green-600 transition">
    <i class="fa fa-whatsapp text-2xl"></i>
</a>

<!-- Footer -->
<footer class="bg-white border-t py-6 mt-8">
    <div class="max-w-7xl mx-auto px-4 text-center">
        <h3 class="font-bold text-lg mb-2" style="color: var(--orange)">Yanika Snack</h3>
        <p class="text-gray-600 mb-2"><i class="fa fa-whatsapp mr-2 text-green-500"></i> <a href="https://wa.me/6285721349673" class="text-green-600 font-medium">0857-2134-9673</a></p>
        <p class="text-sm text-gray-500">© 2026 Yanika Snack - Semua Hak Dilindungi</p>
    </div>
</footer>

<script>
// Data Produk
const products = [
    { id:1, name:"Sagu Salju Dus", weight:"", category:"kue-kering", price:164500, img:"https://via.placeholder.com/400x300/FFF7EA/5C3A1E?text=Sagu+Salju+Dus", featured:true },
    { id:2, name:"Seblak Bintang", weight:"", category:"keripik", price:66500, img:"https://via.placeholder.com/400x300/FFE9CC/5C3A1E?text=Seblak+Bintang", featured:true },
    { id:3, name:"Semprong Segitiga Wijen", weight:"", category:"kue-kering", price:70500, img:"https://via.placeholder.com/400x300/FDF0E0/5C3A1E?text=Semprong+Wijen", featured:true },
    { id:4, name:"Sharon Hitam 20 pack", weight:"", category:"biskuit", price:105500, img:"https://via.placeholder.com/400x300/FFE0B2/E65100?text=Sharon+Hitam", featured:true, promo:true },
    { id:5, name:"Akar Kelapa Manis", weight:"2kg", category:"kue-kering", price:78500, img:"https://via.placeholder.com/400x300/FFF7EA/5C3A1E?text=Akar+Kelapa+Manis" },
    { id:6, name:"Aromanis 5s", weight:"1 Pack", category:"permen", price:11000, img:"https://via.placeholder.com/400x300/F3E5F5/7B1FA2?text=Aromanis+5s" },
    { id:7, name:"Aromanis 5s Bal", weight:"5 Pack", category:"permen", price:50000, img:"https://via.placeholder.com/400x300/E8F5E9/2E7D32?text=Aromanis+5s+Bal" },
    { id:8, name:"Asem", weight:"1 kg / 1 bal 20 pack", category:"lainnya", price:0, img:"https://via.placeholder.com/400x300/EFEBE3/4E342E?text=Asem" },
    { id:9, name:"Astor Mini Belang", weight:"4 kg", category:"biskuit", price:0, img:"https://via.placeholder.com/400x300/E3F2FD/1565C0?text=Astor+Mini+Belang", bestseller:true },
    { id:10, name:"Astor Mini Blueberry", weight:"4 kg", category:"biskuit", price:0, img:"https://via.placeholder.com/400x300/F3E5F5/7B1FA2?text=Astor+Mini+Blueberry" },
];

let cart = [];

// Format Rupiah
function formatRupiah(angka) {
    if (!angka) return 'Hubungi WA';
    return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(angka);
}

// Render Kartu Produk
function createProductCard(product) {
    let badges = '';
    if (product.promo) badges += '<span class="promo-badge">🔥 PROMO SPESIAL!</span>';
    if (product.bestseller) badges += '<span class="bestseller-badge">BEST SELLER</span>';
    
    return `
        <div class="card relative">
            ${badges}
            <img src="${product.img}" alt="${product.name}" class="w-full h-40 object-cover">
            <div class="p-3">
                <h3 class="font-semibold text-sm leading-tight mb-1">${product.name}</h3>
                ${product.weight ? `<p class="text-xs text-gray-500 mb-2">${product.weight}</p>` : ''}
                ${product.category ? `<span class="tag-category mb-2 inline-block">${product.category.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')}</span>` : ''}
                <p class="font-bold text-base mb-3">${formatRupiah(product.price)}</p>
                <button data-id="${product.id}" class="w-full btn-orange-light py-2 rounded-lg text-sm font-medium add-to-cart">
                    + Keranjang
                </button>
            </div>
        </div>
    `;
}

// Render Produk Unggulan di Atas
function renderTopProducts() {
    const container = document.getElementById('top-products');
    const topProducts = products.filter(p => p.featured);
    container.innerHTML = topProducts.map(createProductCard).join('');
    
    container.querySelectorAll('.add-to-cart').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const id = parseInt(e.target.dataset.id);
            addToCart(id);
        });
    });
}

// Render Semua Produk
function renderAllProducts(filter = 'all', search = '') {
    const container = document.getElementById('products');
    container.innerHTML = '';
    
    let filtered = [...products];
    if(filter !== 'all') filtered = filtered.filter(p => p.category === filter);
    if(search) filtered = filtered.filter(p => p.name.toLowerCase().includes(search.toLowerCase()));
    
    container.innerHTML = filtered.map(createProductCard).join('');
    
    container.querySelectorAll('.add-to-cart').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const id = parseInt(e.target.dataset.id);
            addToCart(id);
        });
    });
}

// Tambah ke Keranjang
function addToCart(id) {
    const product = products.find(p => p.id === id);
    cart.push(product);
    document.getElementById('cart-count').textContent = cart.length;
    
    const notif = document.createElement('div');
    notif.className = 'fixed top-24 left-1/2 -translate-x-1/2 bg-green-500 text-white px-6 py-2 rounded-lg shadow-lg z-50 text-sm';
    notif.textContent = `${product.name} ditambahkan ke keranjang!`;
    document.body.appendChild(notif);
    setTimeout(() => notif.remove(), 2000);
}

// Event Listener
document.getElementById('category').addEventListener('change', (e) => {
    renderAllProducts(e.target.value, document.getElementById('search').value);
});

document.getElementById('search').addEventListener('input', (e) => {
    renderAllProducts(document.getElementById('category').value, e.target.value);
});

// Inisialisasi
renderTopProducts();
renderAllProducts();
</script>

</body>
</html>
