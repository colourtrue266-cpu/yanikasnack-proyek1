<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yanika Snack</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #fffbf5; }
        .btn-orange { background-color: #f99d23; }
        .btn-orange:hover { background-color: #e88e15; }
        .card-hover { transition: all 0.3s ease; }
        .card-hover:hover { transform: translateY(-5px); box-shadow: 0 8px 20px rgba(0,0,0,0.1); }
    </style>
</head>
<body class="min-h-screen">

<!-- Header -->
<header class="bg-white shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-orange-500 flex items-center justify-center">
                <i class="fa fa-leaf text-white text-xl"></i>
            </div>
            <h1 class="text-xl font-bold text-gray-800">Yanika Snack</h1>
        </div>
        <div class="relative">
            <button class="btn-orange text-white px-4 py-2 rounded-full flex items-center gap-2">
                <i class="fa fa-shopping-cart"></i>
                <span>Keranjang</span>
                <span id="cart-count" class="bg-white text-orange-500 rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold">0</span>
            </button>
        </div>
    </div>
</header>

<!-- Search & Filter -->
<section class="max-w-7xl mx-auto px-4 py-4">
    <div class="relative mb-4">
        <i class="fa fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
        <input type="text" id="search" placeholder="Cari nama produk..." 
            class="w-full pl-10 pr-4 py-3 rounded-full border border-gray-200 focus:outline-none focus:ring-2 focus:ring-orange-300">
    </div>
    <div class="relative inline-block w-full md:w-auto">
        <select id="category" class="w-full px-4 py-2 rounded-lg border border-gray-200 bg-white">
            <option value="all">Semua Kategori</option>
            <option value="jelly">Jelly</option>
            <option value="keripik">Keripik</option>
            <option value="kacang">Kacang</option>
        </select>
    </div>
</section>

<!-- Produk -->
<section class="max-w-7xl mx-auto px-4 pb-20">
    <h2 class="text-lg font-semibold mb-4">Daftar Produk</h2>
    <div id="products" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <!-- Produk akan dimuat di sini -->
    </div>
</section>

<!-- WA Button Fixed -->
<a href="https://wa.me/6285721349673?text=Halo%20Yanika%20Snack%2C%20saya%20mau%20pesan" 
    target="_blank" 
    class="fixed bottom-6 right-6 bg-green-500 text-white w-14 h-14 rounded-full flex items-center justify-center shadow-lg z-50 hover:bg-green-600 transition">
    <i class="fa fa-whatsapp text-2xl"></i>
</a>

<!-- Footer -->
<footer class="bg-white border-t py-6 mt-8">
    <div class="max-w-7xl mx-auto px-4 text-center">
        <h3 class="font-bold text-lg mb-2">Yanika Snack</h3>
        <p class="text-gray-600 mb-2"><i class="fa fa-whatsapp mr-2"></i> <a href="https://wa.me/6285721349673" class="text-green-600 font-medium">0857-2134-9673</a></p>
        <p class="text-sm text-gray-500">© 2026 Yanika Snack - Semua Hak Dilindungi</p>
    </div>
</footer>

<script>
// Data Produk
const products = [
    { id:1, name:"Jelly Waisun", weight:"1 kg", category:"jelly", price:56500, img:"https://via.placeholder.com/300x200/fff3e0/795548?text=Jelly+Waisun" },
    { id:2, name:"Jengkol Cikruh Asbes", weight:"2 kg", category:"keripik", price:71500, img:"https://via.placeholder.com/300x200/ffe0b2/e65100?text=Jengkol+Cikruh" },
    { id:3, name:"Kaca Asin", weight:"1 kg", category:"keripik", price:53500, img:"https://via.placeholder.com/300x200/f3e5f5/7b1fa2?text=Kaca+Asin" },
    { id:4, name:"Kaca Pedas", weight:"1 kg", category:"keripik", price:53500, img:"https://via.placeholder.com/300x200/fbe9e7/c62828?text=Kaca+Pedas" },
    { id:5, name:"Kacang Atom Bima", weight:"3 kg", category:"kacang", price:139500, img:"https://via.placeholder.com/300x200/e8f5e9/2e7d32?text=Kacang+Atom+Bima" },
    { id:6, name:"Kacang Bandung DB", weight:"5 kg", category:"kacang", price:174500, img:"https://via.placeholder.com/300x200/e3f2fd/1565c0?text=Kacang+Bandung+DB" },
    { id:7, name:"Kacang Bandung Ninja", weight:"5 kg", category:"kacang", price:293500, img:"https://via.placeholder.com/300x200/fafafa/424242?text=Kacang+Bandung+Ninja" },
    { id:8, name:"Kacang Bangkok", weight:"2,5 kg", category:"kacang", price:127500, img:"https://via.placeholder.com/300x200/fff8e1/f9a825?text=Kacang+Bangkok" },
    { id:9, name:"Kacang Banpol", weight:"5 kg", category:"kacang", price:134500, img:"https://via.placeholder.com/300x200/e0f7fa/00838f?text=Kacang+Banpol" },
];

let cart = [];

// Format Rupiah
function formatRupiah(angka) {
    return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(angka);
}

// Render Produk
function renderProducts(filter = 'all', search = '') {
    const container = document.getElementById('products');
    container.innerHTML = '';
    
    let filtered = products;
    if(filter !== 'all') filtered = products.filter(p => p.category === filter);
    if(search) filtered = filtered.filter(p => p.name.toLowerCase().includes(search.toLowerCase()));
    
    filtered.forEach(product => {
        const card = document.createElement('div');
        card.className = 'bg-white rounded-xl shadow-sm overflow-hidden card-hover';
        card.innerHTML = `
            <img src="${product.img}" alt="${product.name}" class="w-full h-48 object-cover">
            <div class="p-4">
                <h3 class="font-semibold text-lg">${product.name}</h3>
                <p class="text-sm text-gray-500 mb-2">${product.weight}</p>
                <span class="inline-block bg-orange-100 text-orange-600 text-xs px-2 py-1 rounded-full mb-3">${product.category.charAt(0).toUpperCase() + product.category.slice(1)}</span>
                <p class="font-bold text-lg text-orange-500 mb-3">${formatRupiah(product.price)}</p>
                <button data-id="${product.id}" class="w-full btn-orange text-white py-2 rounded-lg font-medium add-to-cart">
                    + Keranjang
                </button>
            </div>
        `;
        container.appendChild(card);
    });

    // Tambah event listener
    document.querySelectorAll('.add-to-cart').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const id = parseInt(e.target.dataset.id);
            addToCart(id);
        });
    });
}

// Tambah ke Keranjang
function addToCart(id) {
    const product = products.find(p => p.id === id);
    cart.push(product);
    document.getElementById('cart-count').textContent = cart.length;
    
    // Notifikasi
    const notif = document.createElement('div');
    notif.className = 'fixed top-20 left-1/2 -translate-x-1/2 bg-green-500 text-white px-6 py-2 rounded-lg shadow-lg z-50';
    notif.textContent = `${product.name} ditambahkan ke keranjang!`;
    document.body.appendChild(notif);
    setTimeout(() => notif.remove(), 2000);
}

// Event Listener
document.getElementById('category').addEventListener('change', (e) => {
    renderProducts(e.target.value, document.getElementById('search').value);
});

document.getElementById('search').addEventListener('input', (e) => {
    renderProducts(document.getElementById('category').value, e.target.value);
});

// Inisialisasi
renderProducts();
</script>

</body>
</html>
